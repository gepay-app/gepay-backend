# --- Aplikasi (prefix APP_) ---
APP_ENV=development
APP_NAME=app
APP_PORT=8080
# Level minimum log: debug | info | warn | error.
# Kosongkan = otomatis (production => info, lainnya => debug).
APP_LOG_LEVEL=debug
# Format log: json | text. Kosongkan = otomatis (production => json).
APP_LOG_FORMAT=text

# --- Database (prefix DB_) — DB_URL wajib ---
DB_URL=postgres://root:root@localhost:5432/gepay?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=10m

# --- Redis (prefix REDIS_) ---
REDIS_ADDR=localhost:6379
REDIS_USERNAME=root
REDIS_PASSWORD=root
REDIS_DB=0

# Goose migration
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://root:root@localhost:5432/app?sslmode=disable
GOOSE_MIGRATION_DIR=./db/postgres/migrations

#firebase
FIREBASE_SERVICE_ACCOUNT_BASE64=